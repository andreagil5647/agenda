{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node", "jest", "@testing-library/jest-dom"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowJs": false,
    // The webpack config files run directly under Node (--experimental-strip-types),
    // which requires explicit extensions on relative imports; app code under src/
    // is bundled by webpack instead and conventionally omits them.
    "allowImportingTsExtensions": true,

    "paths": {
      "@/*": ["./src/*"]
    },

    "noEmit": true
  },
  "include": ["src", "config", "test", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
