{
  "name": "agenda",
  "version": "0.1.0",
  "private": true,
  "description": "Web app for Agenda, a calendar and task planner built around time-blocking.",
  "license": "MIT",
  "author": "Andrea Gil Guimerà",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "webpack serve --config config/webpack/webpack.dev.ts",
    "build": "webpack --config config/webpack/webpack.prod.ts",
    "analyze": "webpack --config config/webpack/webpack.prod.ts --env analyze",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
