# Copy to .env for local development. Never commit .env.
# Read at BUILD time by config/webpack/env.ts, not at runtime.

# The API has no setting here: it is always called on the page's own origin.
# In dev the webpack-dev-server proxy forwards /api/* to the backend (see
# config/webpack/webpack.dev.ts), and in production the static site's rewrite
# does the same (see render.yaml).

PUBLIC_APP_VERSION=dev
