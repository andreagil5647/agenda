# Copy to .env for local development. Never commit .env.
# Read at BUILD time by config/webpack/env.ts, not at runtime.

# Left relative on purpose: in dev the webpack-dev-server proxy forwards it
# to the backend (see config/webpack/webpack.dev.ts), and in production the
# static site's rewrite does the same (see render.yaml). This keeps the API
# same-origin with the web app in both environments.
PUBLIC_API_BASE_URL=/api/v1

PUBLIC_APP_VERSION=dev
